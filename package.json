{
  "name": "payload-plugin-socials",
  "version": "0.11.1",
  "description": "Multi-platform social publishing plugin for Payload CMS — Pinterest, Instagram Business, Facebook Pages, Google Business Profile",
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "social",
    "pinterest",
    "instagram",
    "facebook",
    "google-business-profile",
    "social-publishing",
    "social-media-automation"
  ],
  "homepage": "https://github.com/ContiDigital/payload-plugin-socials#readme",
  "bugs": {
    "url": "https://github.com/ContiDigital/payload-plugin-socials/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContiDigital/payload-plugin-socials.git"
  },
  "license": "MIT",
  "author": "Conti Digital",
  "packageManager": "pnpm@10.16.1",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "types": "./dist/exports/rsc.d.ts",
      "import": "./dist/exports/rsc.js",
      "default": "./dist/exports/rsc.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --source-maps false --strip-leading-paths --ignore \"**/*.test.ts\" --ignore \"**/*.d.scss.ts\" --ignore \"**/__tests__/**\" && rimraf --glob \"dist/**/*.scss.d.js\" \"dist/**/*.scss.d.js.map\" \"dist/**/*.scss.d.ts\"",
    "build:types": "tsc -p tsconfig.build.json",
    "audit:all": "pnpm audit --audit-level high --ignore GHSA-mh99-v99m-4gvg",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json,d.ts}\" \"src/**/*.d.scss.ts\" dist/",
    "dev": "next dev dev --turbo",
    "dev:e2e": "cross-env SOCIALS_E2E=true DATABASE_URI=file:./dev/e2e-database.db WATCHPACK_POLLING=true next dev dev --webpack",
    "dev:generate-importmap": "cd dev && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts ../node_modules/.bin/payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap && prettier --write 'dev/app/(payload)/admin/importMap.js'",
    "generate:types": "pnpm dev:generate-types",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "package:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "pack:smoke": "bash ./scripts/pack-smoke.sh",
    "predev:e2e": "rimraf dev/e2e-database.db",
    "release:check": "pnpm format:check && pnpm lint && pnpm exec tsc --noEmit && pnpm test:coverage && pnpm build && pnpm pack:smoke && pnpm package:check && pnpm audit:prod",
    "test": "pnpm test:int",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:int": "vitest --run",
    "test:live": "vitest --run --config vitest.live.config.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@payloadcms/db-mongodb": "3.86.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@playwright/test": "1.63.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.15.46",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "copyfiles": "2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "graphql": "^16.14.2",
    "next": "16.3.6",
    "payload": "3.86.0",
    "pino": "10.3.1",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "payload": "^3.84.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/next": {
      "optional": true
    },
    "@payloadcms/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@eslint/plugin-kit@<0.3.4": "0.3.5",
      "@typescript-eslint/parser": "8.63.0",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=3.0.0 <5.0.8": "5.0.8",
      "dompurify@<3.4.12": "3.4.12",
      "esbuild@<0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <=3.1.3": "3.1.4",
      "mongoose@>=8.0.0 <8.24.1": "8.24.1",
      "postcss@<8.5.18": "8.5.23",
      "sharp@<0.35.0": "0.35.3",
      "vite@<7.3.5": "7.3.6"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
